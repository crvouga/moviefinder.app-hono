{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviefinder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "www.moviefinder.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
