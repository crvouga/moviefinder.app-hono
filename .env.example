# Secrets are managed with Doppler — see doppler.yaml.
#   1. doppler login
#   2. doppler setup            # selects the moviefinder / dev config
#   3. bun run dev              # scripts wrap commands in `doppler run`
#
# Set these in Doppler (dashboard or `doppler secrets set NAME`), not in a .env file.
# This file documents the expected variables only.

# --- Application runtime (pushed to Fly via `fly secrets set`) ---
TMDB_API_READ_ACCESS_TOKEN=   # required — TMDB v4 "API Read Access Token" (sent as Bearer)
OPENAI_API_KEY=               # optional — only if the app uses OpenAI
OPENAI_PROJECT_ID=            # optional
TWILIO_ACCOUNT_SID=           # optional
TWILIO_AUTH_TOKEN=            # optional
TWILIO_SERVICE_SID=           # optional
DATABASE_PATH=                # /data/app.db in prod, defaults to ./app.db in dev
PORT=3000

# --- Deploy tooling (used by deploy/, never sent to the running app) ---
# Run the deploy with: `bun run deploy` (wraps `doppler run`).
FLY_API_TOKEN=                # required — fly.io API token
CLOUDFLARE_API_TOKEN=         # required — scopes: Zone:DNS:Edit, Zone:Dynamic Redirect:Edit, Zone:Read
CLOUDFLARE_ACCOUNT_ID=        # required
# CI only: store a Doppler service token as the GitHub secret DOPPLER_TOKEN.
# GHCR_REPOSITORY / IMAGE_TAG are provided by the GitHub Actions deploy job.
