# Secrets are managed with Vault — see .vault.yaml.
#   1. vault login hvs.xxx          # or a scoped dev token
#   2. vault setup --project personal --config dev
#   3. bun run dev                  # vault run → Bun server on :8787
#
# Set these in Vault (secret/personal/dev or secret/personal/prd), not in a .env file.
# This file documents the expected variables only.

# --- Application runtime (set on Fly via `fly secrets import`) ---
DATABASE_URL=                 # Neon Postgres connection string (dev/prd branches in Vault)
TMDB_API_READ_ACCESS_TOKEN=   # required — TMDB v4 "API Read Access Token" (sent as Bearer)
OPENAI_API_KEY=               # optional — only if the app uses OpenAI
OPENAI_PROJECT_ID=            # optional
TWILIO_ACCOUNT_SID=           # optional
TWILIO_AUTH_TOKEN=            # optional
TWILIO_SERVICE_SID=           # optional
BETTER_AUTH_SECRET=           # required — Better Auth signing secret
BETTER_AUTH_URL=              # required in prod — e.g. https://www.moviefinder.app (local dev defaults to http://localhost:8787)

# --- Deploy tooling (used by deploy/, never sent to the running app) ---
# Run the deploy with: `bun run deploy` (wraps `vault run`).
FLY_API_TOKEN=                # required — Fly.io deploy and secrets
FLY_ORG=                      # optional — Fly org slug when creating a new app
CLOUDFLARE_API_TOKEN=         # required — scopes: Zone:DNS:Edit, Zone:Dynamic Redirect:Edit, Zone:Read
CLOUDFLARE_ACCOUNT_ID=        # required
