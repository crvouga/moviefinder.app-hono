# Secrets are managed with Doppler — see doppler.yaml.
#   1. doppler login
#   2. doppler setup            # selects the moviefinder / dev config
#   3. bun run dev              # scripts wrap commands in `doppler run`
#
# Set these in Doppler (dashboard or `doppler secrets set NAME`), not in a .env file.
# This file documents the expected variables only.

TMDB_API_READ_ACCESS_TOKEN=   # required — TMDB v4 "API Read Access Token" (sent as Bearer)
DATABASE_PATH=                # /data/app.db in prod, defaults to ./app.db in dev
PORT=3000
